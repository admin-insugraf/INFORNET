        Public Function AnulacionFacturacion(ByVal _DOCUMENT_ID As String, ByVal _NUMBER_SERIE As String, _
                                             ByVal _NUMBER_DOCUMENT As String, ByVal _ALMACEN As String, ByVal _MOTIVO As String) As Boolean
            Dim ESTADO As Boolean = True
            Dim tr As SqlTransaction
            tr = cn.BeginTransaction(IsolationLevel.Serializable)
            Try
                SqlHelper.ExecuteNonQuery(tr, "FACT_SP_S_RECEIVABLE_ANULACION", _DOCUMENT_ID, _NUMBER_SERIE, _NUMBER_DOCUMENT, _MOTIVO)
                SqlHelper.ExecuteNonQuery(tr, "GUIA_SP_S_GUIA_REMISION_NUM_DOCUMENT_GS", _DOCUMENT_ID, Val(_NUMBER_DOCUMENT), _NUMBER_SERIE)

                Dim dtOrdenC As DataTable
                Dim NUM_PEDIDO As String
                dtOrdenC = New DataTable
                dtOrdenC = SqlHelper.ExecuteDataset(tr, "VENTAS_SP_S_VERIFICA_PEDIDO", _DOCUMENT_ID, _NUMBER_SERIE, _NUMBER_DOCUMENT).Tables(0)

                If dtOrdenC.Rows.Count() <> 0 Then
                    NUM_PEDIDO = dtOrdenC.Rows(0).Item("PEDIDO").ToString
                    dtOrdenC = New DataTable
                    dtOrdenC = SqlHelper.ExecuteDataset(tr, "VENTAS_SP_S_SALDO_PEDIDOS", NUM_PEDIDO).Tables(0)
                    If dtOrdenC.Rows.Count() <> 0 Then
                        dtOrdenC = New DataTable
                        dtOrdenC = SqlHelper.ExecuteDataset(tr, "VENTAS_SP_S_PEDIDOS_CON_FACTURA", NUM_PEDIDO).Tables(0)
                        If dtOrdenC.Rows.Count() <> 0 Then
                            SqlHelper.ExecuteNonQuery(tr, CommandType.Text, "UPDATE ORDERS SET STATUS='FP',STATUS_ORDER='APROBADO' WHERE ID ='" & NUM_PEDIDO & "'")
                        Else
                            SqlHelper.ExecuteNonQuery(tr, CommandType.Text, "UPDATE ORDERS SET STATUS='V',STATUS_ORDER='APROBADO' WHERE ID ='" & NUM_PEDIDO & "'")
                        End If
                    Else
                        SqlHelper.ExecuteNonQuery(tr, CommandType.Text, "UPDATE ORDERS SET STATUS='F',STATUS_ORDER='FACTURADO' WHERE ID ='" & NUM_PEDIDO & "'")
                    End If

                End If

                dtOrdenC = New DataTable
                dtOrdenC = SqlHelper.ExecuteDataset(tr, "FACT_SP_S_RECEIVABLE_LINE", _DOCUMENT_ID, _NUMBER_SERIE, _NUMBER_DOCUMENT).Tables(0)

                If dtOrdenC.Rows.Count() <> 0 Then
                    For i As Integer = 0 To dtOrdenC.Rows.Count - 1
                        SqlHelper.ExecuteNonQuery(tr, "ACT_QTY_LOTE_2010_AL_CON_ARTICULO", _ALMACEN, dtOrdenC.Rows(i).Item("CODIGO").ToString)
                    Next
                End If

