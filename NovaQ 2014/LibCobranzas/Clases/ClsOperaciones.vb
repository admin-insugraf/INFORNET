                                Dim tempArray() As String
                                Dim Strdatos_adicional As String = ""
                                Strdatos_adicional = dt_data.Tables(1).Rows(J)("PART_DESCRIPTION_ADICIONAL")
                                tempArray = Strdatos_adicional.Split(CChar(vbLf))
                                For k = LBound(tempArray) To UBound(tempArray)
                                    sw.WriteLine("<Description>" & Trim(tempArray(k)) & "</Description>")
                                Next k
                                'fin de aki debemos obtener las lineas de la observacion

                                sw.WriteLine("<SellersItemIdentification>")
                                sw.WriteLine("<ID>" & dt_data.Tables(1).Rows(J)("PART_ID") & "</ID>")
                                sw.WriteLine("</SellersItemIdentification>")
                                sw.WriteLine("</Item>")
                                sw.WriteLine("<Price>")
                                sw.WriteLine("<PriceAmount>" & Format(Double.Parse(dt_data.Tables(1).Rows(J)("PRICE_ORI")), "####0.000000") & "</PriceAmount>")
                                sw.WriteLine("</Price>")

                                If _TipoDoc = "NC" Then
                                    sw.WriteLine("</CreditNoteLine>")
                                ElseIf _TipoDoc = "ND" Then
                                    sw.WriteLine("</DebitNoteLine>")
                                End If

                            Next

                            'LEYENDAS
                            sw.WriteLine("<AdditionalInformation>")
                            sw.WriteLine("<AdditionalProperty>")
                            sw.WriteLine("<ID>" & dt_data.Tables(0).Rows(i)("CODIGO_LEYENDA") & "</ID>")
                            sw.WriteLine("<Value>" & dt_data.Tables(0).Rows(i)("MONTO_PALABRAS") & "</Value>")
                            sw.WriteLine("</AdditionalProperty>")
                            sw.WriteLine("</AdditionalInformation>")

                            'DATOS ADJUNTO COMO VENDEDOR Y FORMA DE PAGO
                            sw.WriteLine("<Adjuntos>")
                            If dt_data.Tables(0).Rows(i)("OBSERVACIONES") = "" Then
                                sw.WriteLine("<Observacion>-</Observacion>")
                            Else
                                sw.WriteLine("<Observacion>" & dt_data.Tables(0).Rows(i)("OBSERVACIONES") & "</Observacion>")
                            End If

                            sw.WriteLine("<FechaVencimiento>-</FechaVencimiento>")
                            sw.WriteLine("<Vendedor>" & dt_data.Tables(0).Rows(i)("VENDEDOR") & "</Vendedor>")
                            sw.WriteLine("<FormaPago>" & dt_data.Tables(0).Rows(i)("FORMA_PAGO") & "</FormaPago>")
                            sw.WriteLine("<IndFormato>" & _ticket_a4 & "</IndFormato>")
                            sw.WriteLine("<Vuelto>" & Format(Double.Parse(dt_data.Tables(0).Rows(i)("VUELTO")), "####0.00") & "</Vuelto>")
                            sw.WriteLine("<PorRetencion>" & Format(Double.Parse(dt_data.Tables(0).Rows(i)("PORRETENCION")), "####0.00") & "</PorRetencion>")
                            sw.WriteLine("<PorDetraccion>" & Format(Double.Parse(dt_data.Tables(0).Rows(i)("PORDETRACCION")), "####0.00") & "</PorDetraccion>")
                            sw.WriteLine("</Adjuntos>")

                            If _TipoDoc = "NC" Then
                                sw.WriteLine("</CreditNote>")
                            ElseIf _TipoDoc = "ND" Then
                                sw.WriteLine("</DebitNote>")
                            End If

                        Next

                    End If

                    sw.Close()

                    dt_data = Nothing
                    Return True
                Else
                    Return False
                End If

            Catch ex As Exception
                MsgBox(ex.Message)
                Return False
            End Try

        End Function
