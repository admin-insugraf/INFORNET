                                                  .WAREHOUSE_REF, .ACCOUNT, .STATUS_VALUE, .NUM_PROTOCOLOS, .OPT_ENTREGA, .QT_BULTOS, .PROCEDENCIA, .PAIS_ORIGEN, _
                                                  .AVERAGE_COST, .CURRENCY_ID, .NUMBER_ANALIS)

                        SqlHelper.ExecuteNonQuery(tr, "ALM_SP_I_WAREHOUSE_TRANS_LINE_ADICIONALES", entidad.NUM_ID_REF, .ITEM, .PART_ID, .QTY, .NUMBER_LOT, _
                                                  .WAREHOUSE_ID, .DOCUMENT_ID, .NUMBER_DOCUMENT, entidad.DATE_DOCUMENT, LibComunVar.ClsVarComun.USUARIO)
                    End With
                Next
                ''Actualizando ..
                SqlHelper.ExecuteNonQuery(tr, "ALM_SP_U_WH_LOTE_FABRICAR", entidad.WAREHOUSE_ID, entidad.DOCUMENT_ID, entidad.NUMBER_DOCUMENT, Lote_Fabricar)
