        Public Function Genera_Txt_Electronico_Resumen_Boletas(ByVal _Fecha_Resumen As String, ByVal _ruta As String, ByVal _Codigo_Resumen As String) As Boolean
            Try
                Dim fq As New LibContabilidad.ClsOperaciones.freeQuery
                Dim dt_info_emp As DataTable = fq.get_Info_Empresa()
                Dim StrNomArchivo As String
                Dim Strdatos As String = ""
                Dim ruc As String = String.Empty
                Dim razon As String = String.Empty
                Dim TDOC As String = String.Empty

                If dt_info_emp.Rows.Count > 0 Then
                    ruc = dt_info_emp.Rows(0)("VAT_REGISTRATION").ToString()
                    razon = dt_info_emp.Rows(0)("REPORT_SCREEN").ToString()
                End If

                Dim dt_data As DataSet = SqlHelper.ExecuteDataset(cn, "VENTAS_SP_S_RECEIVABLE_TXT_ELECTRONICO_RESUMEN_BOLETAS", _Fecha_Resumen, _Codigo_Resumen)

                If dt_data.Tables(0).Rows.Count > 0 Then
                    StrNomArchivo = _ruta & "\" & dt_data.Tables(0).Rows(0)("CODIGO_RESUMEN") & ".txt"


                    If Dir(StrNomArchivo) <> "" Then Kill(StrNomArchivo)
                    If Dir(_ruta, vbDirectory) = "" Then MkDir(_ruta)

                    Dim sw As New System.IO.StreamWriter(StrNomArchivo, True, System.Text.Encoding.GetEncoding(1252))

                    For i As Integer = 0 To dt_data.Tables(0).Rows.Count - 1

                        Strdatos = "RC" & "|"
                        Strdatos = Strdatos & CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Day, "00") & "|"
                        Strdatos = Strdatos & CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Day, "00") & "|"
                        Strdatos = Strdatos & "RC-" & CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Year.ToString & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Month, "00") & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Day, "00") & "-" & CInt(dt_data.Tables(1).Rows(0)("ITEM")) & "|}"
                        sw.WriteLine(Strdatos)

                        Strdatos = dt_data.Tables(0).Rows(i)("NUMERO_RUC") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("RAZON_SOCIAL") & "||"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("UBIGEO_EMISOR") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("DIRECCION_FISCAL") & "||"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("PROVINCIA_EMISOR") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("DEPARTAMENTO_EMISOR") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("DISTRITO_EMISOR") & "||}~"
                        sw.WriteLine(Strdatos)

                        For j As Integer = 0 To dt_data.Tables(0).Rows.Count - 1
                            Strdatos = dt_data.Tables(0).Rows(j)("NUMERO_FILA") & "|"
                            Strdatos = Strdatos & dt_data.Tables(0).Rows(j)("CODIGO_SUNAT") & "|"
                            Strdatos = Strdatos & dt_data.Tables(0).Rows(j)("NUMBER_SERIE") & "-" & dt_data.Tables(0).Rows(j)("NUMBER_DOCUMENT") & "|"
                            Strdatos = Strdatos & dt_data.Tables(0).Rows(j)("DOCUMENTO_CLIENTE") & "|"
                            Strdatos = Strdatos & dt_data.Tables(0).Rows(j)("TIPO_DOC_CLIENTE") & "||||||||"
                            Strdatos = Strdatos & dt_data.Tables(0).Rows(j)("ESTADO_ITEM") & "|"
                            Strdatos = Strdatos & Format(Double.Parse(dt_data.Tables(0).Rows(j)("TOTAL")), "####0.00") & "||"
                            Strdatos = Strdatos & Format(Double.Parse(dt_data.Tables(0).Rows(j)("TOTAL")), "####0.00") & "||"

                            If Double.Parse(dt_data.Tables(0).Rows(j)("TOTAL_GRATUITO")) <> 0 Then
                                Strdatos = Strdatos & Format(Double.Parse(dt_data.Tables(0).Rows(j)("TOTAL_GRATUITO")), "####0.00") & "|"
                            Else
                                Strdatos = Strdatos & "|"
                            End If

                            Strdatos = Strdatos & "||"

                            Strdatos = Strdatos & Format(Double.Parse(dt_data.Tables(0).Rows(j)("IGV")), "####0.00") & "||}"
                            sw.WriteLine(Strdatos)
                        Next
                        Strdatos = "~"
                        sw.WriteLine(Strdatos)

                        Strdatos = "\"
                        sw.WriteLine(Strdatos)
                        Exit For
                    Next

                    sw.Close()

                    dt_data = Nothing
                    Return True
                Else
                    Return False
                End If

            Catch ex As Exception
                MsgBox(ex.Message)
                Return False
            End Try
        End Function

        Public Function Genera_XML_Electronico_Resumen_Boletas(ByVal _Fecha_Resumen As String, ByVal _ruta As String, ByVal codigo_resumen As String, ByVal estado_documentos As String) As Boolean
            Try
                Dim fq As New LibContabilidad.ClsOperaciones.freeQuery
                Dim dt_info_emp As DataTable = fq.get_Info_Empresa()
                Dim StrNomArchivo As String
                Dim Strdatos As String = ""
                Dim ruc As String = String.Empty
                Dim razon As String = String.Empty
                Dim TDOC As String = String.Empty

                If dt_info_emp.Rows.Count > 0 Then
                    ruc = dt_info_emp.Rows(0)("VAT_REGISTRATION").ToString()
                    razon = dt_info_emp.Rows(0)("REPORT_SCREEN").ToString()
                End If

                Dim dt_data As DataSet = SqlHelper.ExecuteDataset(cn, "VENTAS_SP_S_RECEIVABLE_TXT_ELECTRONICO_RESUMEN_BOLETAS", _Fecha_Resumen, codigo_resumen)

                If dt_data.Tables(0).Rows.Count > 0 Then
                    StrNomArchivo = _ruta & "\" & dt_data.Tables(0).Rows(0)("CODIGO_RESUMEN_BOLETAS")

                    If Dir(StrNomArchivo) <> "" Then Kill(StrNomArchivo)
                    If Dir(_ruta, vbDirectory) = "" Then MkDir(_ruta)

                    Dim sw As New System.IO.StreamWriter(StrNomArchivo, True, System.Text.Encoding.GetEncoding(1252))

                    For i As Integer = 0 To dt_data.Tables(0).Rows.Count - 1
                        'sw.WriteLine("<?xml version=""1.0"" encoding=""UTF-8"" standalone=""no""?>")
                        sw.WriteLine("<?xml version=""1.0"" encoding=""ISO-8859-1""?>")
                        sw.WriteLine("<SummaryDocuments>")
                        sw.WriteLine("<ID>RC-" & CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Year.ToString & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Month, "00") & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Day, "00") & "-" & CInt(dt_data.Tables(1).Rows(0)("ITEM")) & "</ID>")
                        sw.WriteLine("<ReferenceDate>" & CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Day, "00") & "</ReferenceDate>")
                        sw.WriteLine("<IssueDate>" & CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_RESUMEN")).Day, "00") & "</IssueDate>")
                        sw.WriteLine("<InvoiceTypeCode>RC</InvoiceTypeCode>")
                        sw.WriteLine("<DocumentCurrencyCode>PEN</DocumentCurrencyCode>")

                        'DATOS DEL EMISOR
                        sw.WriteLine("<AccountingSupplierParty>")
                        sw.WriteLine("<CustomerAssignedAccountID>" & dt_data.Tables(0).Rows(i)("NUMERO_RUC") & "</CustomerAssignedAccountID>")
                        sw.WriteLine("<ID>6</ID>")
                        sw.WriteLine("<PartyLegalEntity>")
                        sw.WriteLine("<RegistrationName>" & dt_data.Tables(0).Rows(i)("RAZON_SOCIAL") & "</RegistrationName>")
                        sw.WriteLine("</PartyLegalEntity>")
                        sw.WriteLine("</AccountingSupplierParty>")

                        For j As Integer = 0 To dt_data.Tables(0).Rows.Count - 1
                            sw.WriteLine("<SummaryDocumentsLine>")
                            sw.WriteLine("<LineID>" & dt_data.Tables(0).Rows(j)("NUMERO_FILA") & "</LineID>")
                            sw.WriteLine("<DocumentTypeCode>" & dt_data.Tables(0).Rows(j)("CODIGO_SUNAT") & "</DocumentTypeCode>")
                            sw.WriteLine("<ID>" & dt_data.Tables(0).Rows(j)("NUMBER_SERIE") & "-" & dt_data.Tables(0).Rows(j)("NUMBER_DOCUMENT") & "</ID>")
                            sw.WriteLine("<AccountingCustomerParty>")
                            sw.WriteLine("<CustomerAssignedAccountID>" & dt_data.Tables(0).Rows(j)("DOCUMENTO_CLIENTE") & "</CustomerAssignedAccountID>")
                            sw.WriteLine("<AdditionalAccountID>" & dt_data.Tables(0).Rows(j)("TIPO_DOC_CLIENTE") & "</AdditionalAccountID>")
                            sw.WriteLine("</AccountingCustomerParty>")

                            'DATOS DEL COMPROBANTE DE REFERENCIA
                            If dt_data.Tables(0).Rows(j)("CODIGO_SUNAT") = "07" Or dt_data.Tables(0).Rows(j)("CODIGO_SUNAT") = "08" Then
                                sw.WriteLine("<InvoiceDocumentReference>")
                                sw.WriteLine("<ID>" & dt_data.Tables(0).Rows(j)("SERIE_REF") & "-" & dt_data.Tables(0).Rows(j)("NUMBER_REF") & "</ID>")
                                sw.WriteLine("<DocumentTypeCode>" & dt_data.Tables(0).Rows(j)("DOCUMENT_REF") & "</DocumentTypeCode>")
                                sw.WriteLine("</InvoiceDocumentReference>")
                            End If

                            sw.WriteLine("<Status>")
                            sw.WriteLine("<ConditionCode>" & estado_documentos & "</ConditionCode>")
                            sw.WriteLine("</Status>")
                            sw.WriteLine("<TotalAmount>" & Format(dt_data.Tables(0).Rows(j)("TOTAL"), "####0.00") & "</TotalAmount>")
                            sw.WriteLine("<BillingPayment>")
                            sw.WriteLine("<PaidAmount>" & Format(dt_data.Tables(0).Rows(j)("VALOR_VENTA"), "####0.00") & "</PaidAmount>")
                            sw.WriteLine("<InstructionID>" & dt_data.Tables(0).Rows(j)("TIPO_VENTA") & "</InstructionID>")
                            sw.WriteLine("</BillingPayment>")

                            sw.WriteLine("<TaxTotal>")
                            sw.WriteLine("<TaxAmount>" & Format(dt_data.Tables(0).Rows(j)("IGV"), "####0.00") & "</TaxAmount>")
                            sw.WriteLine("<TaxSubtotal>")
                            sw.WriteLine("<TaxAmount>" & Format(dt_data.Tables(0).Rows(j)("IGV"), "####0.00") & "</TaxAmount>")
                            sw.WriteLine("<TaxCategory>")
                            sw.WriteLine("<TaxScheme>")
                            sw.WriteLine("<ID>1000</ID>")
                            sw.WriteLine("<Name>IGV</Name>")
                            sw.WriteLine("<TaxTypeCode>VAT</TaxTypeCode>")
                            sw.WriteLine("</TaxScheme>")
                            sw.WriteLine("</TaxCategory>")
                            sw.WriteLine("</TaxSubtotal>")
                            sw.WriteLine("</TaxTotal>")
                            sw.WriteLine("</SummaryDocumentsLine>")
                        Next

                        sw.WriteLine("</SummaryDocuments>")

                        Exit For
                    Next

                    sw.Close()

                    dt_data = Nothing
                    Return True
                Else
                    Return False
                End If

            Catch ex As Exception
                MsgBox(ex.Message)
                Return False
            End Try

        End Function

