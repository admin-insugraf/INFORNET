                            detalle.AD_IDCAB = 0
                            detalle.AD_SECUENCIA = ls_det.Count + 1
                            detalle.AD_CUENTA = dt_detalles.Rows(j)("ACCOUNT").ToString()
                            _Consulta = String.Empty
