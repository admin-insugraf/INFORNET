        Public Function Genera_Txt_Electronico_Comunicacion_Baja(ByVal _TipoDoc As String, ByVal _serie As String, ByVal _NumeroDoc As String, _
                                               ByVal _ruta As String, ByVal _fecha As String) As Boolean
            Try
                Dim fq As New LibContabilidad.ClsOperaciones.freeQuery
                Dim dt_info_emp As DataTable = fq.get_Info_Empresa()
                Dim StrNomArchivo As String
                Dim Strdatos As String = ""
                Dim ruc As String = String.Empty
                Dim razon As String = String.Empty
                Dim TDOC As String = String.Empty

                If dt_info_emp.Rows.Count > 0 Then
                    ruc = dt_info_emp.Rows(0)("VAT_REGISTRATION").ToString()
                    razon = dt_info_emp.Rows(0)("REPORT_SCREEN").ToString()
                End If

                Dim dt_data As DataSet = SqlHelper.ExecuteDataset(cn, "VENTAS_SP_S_RECEIVABLE_TXT_ELECTRONICO_COMUNICACION_BAJA", _TipoDoc, _serie, _NumeroDoc, _fecha)

                If dt_data.Tables(0).Rows.Count > 0 Then
                    StrNomArchivo = _ruta & "\RA-" & CDate(_fecha).Year.ToString & Format(CDate(_fecha).Month, "00") & Format(CDate(_fecha).Day, "00") & "-" & Format(CInt(dt_data.Tables(1).Rows(0)("ITEM")), "00000") & ".txt"

                    Dim _NOMBRE_ARCHIVO As String = "RA-" & CDate(_fecha).Year.ToString & Format(CDate(_fecha).Month, "00") & Format(CDate(_fecha).Day, "00") & "-" & dt_data.Tables(1).Rows(0)("ITEM").ToString & ".xml"
                    SqlHelper.ExecuteNonQuery(cn, "VENTAS_SP_S_RECEIVABLE_COMUNICACION_BAJA", _TipoDoc, _serie, _NumeroDoc, _NOMBRE_ARCHIVO)

                    If Dir(StrNomArchivo) <> "" Then Kill(StrNomArchivo)
                    If Dir(_ruta, vbDirectory) = "" Then MkDir(_ruta)

                    Dim sw As New System.IO.StreamWriter(StrNomArchivo, True, System.Text.Encoding.GetEncoding(1252))

                    For i As Integer = 0 To dt_data.Tables(0).Rows.Count - 1

                        Strdatos = "RA" & "|"
                        Strdatos = Strdatos & CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Day, "00") & "|"
                        Strdatos = Strdatos & CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Day, "00") & "|"
                        Strdatos = Strdatos & "RA-" & CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Year.ToString & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Month, "00") & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Day, "00") & "-" & CInt(dt_data.Tables(1).Rows(0)("ITEM")) & "|}"
                        sw.WriteLine(Strdatos)

                        Strdatos = dt_data.Tables(0).Rows(i)("NUMERO_RUC") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("RAZON_SOCIAL") & "||"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("UBIGEO_EMISOR") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("DIRECCION_FISCAL") & "||"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("PROVINCIA_EMISOR") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("DEPARTAMENTO_EMISOR") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("DISTRITO_EMISOR") & "||}~"
                        sw.WriteLine(Strdatos)

                        Strdatos = "1|" & dt_data.Tables(0).Rows(i)("CODIGO_SUNAT") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("NUMBER_SERIE") & "|" & dt_data.Tables(0).Rows(i)("NUMBER_DOCUMENT") & "|"
                        Strdatos = Strdatos & dt_data.Tables(0).Rows(i)("MOTIVO_BAJA") & "|}~"
                        sw.WriteLine(Strdatos)

                        Strdatos = "\"
                        sw.WriteLine(Strdatos)
                    Next



                    sw.Close()

                    dt_data = Nothing
                    Return True
                Else
                    Return False
                End If

            Catch ex As Exception
                MsgBox(ex.Message)
                Return False
            End Try

        End Function

