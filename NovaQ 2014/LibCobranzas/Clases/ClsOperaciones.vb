                        sw.WriteLine("<NetWeightMeasure>" & Format(Double.Parse(dt_data.Tables(0).Rows(i)("PESO_NETO")), "####0.00") & "</NetWeightMeasure>")
                        sw.WriteLine("<Unitcode>" & dt_data.Tables(0).Rows(i)("UNIDAD_PESO_BRUTO") & "</Unitcode>")
                        sw.WriteLine("<ShipmentStage>")
                        sw.WriteLine("<TransportModeCode>" & dt_data.Tables(0).Rows(i)("MODALIDAD_TRANSPORTE") & "</TransportModeCode>")
                        sw.WriteLine("<TransitPeriod>")
                        sw.WriteLine("<StartDate>" & CDate(dt_data.Tables(0).Rows(i)("FECHA_TRASLADO")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_TRASLADO")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_TRASLADO")).Day, "00") & "</StartDate>")
