        Public Function GuardarFactura_Resumen_Boletas_SUNAT(entidad As ClsEntidades.RECEIVABLE_RESUMEN_BOLETAS, lista As List(Of ClsEntidades.RECEIVABLE_RESUMEN_BOLETAS_LINE)) As Boolean

            Dim estados As Boolean = True
            Dim tr As SqlTransaction
            Dim _id_Cabecera As Integer = 0
            tr = cn.BeginTransaction(IsolationLevel.Serializable)
            Try
                With entidad
                    _id_Cabecera = SqlHelper.ExecuteScalar(tr, "FACT_SP_I_RECEIVABLE_RESUMEN_BOLETAS", .CODIGO_RESUMEN, .FECHA_DOCUMENTOS, .NUMERO_TICKET, .USER_ID, _
                                                           .PC_ID, .CODIGO_RESUMEN_BOLETAS)
                End With

                For Each d As ClsEntidades.RECEIVABLE_RESUMEN_BOLETAS_LINE In lista
                    With d
                        SqlHelper.ExecuteNonQuery(tr, "FACT_SP_I_RECEIVABLE_RESUMEN_BOLETAS_LINE", _id_Cabecera, .ITEM, .TIPO_DOC, .SERIE_DOC, .NUMERO_DOC, .OPE_GRABADAS, _
                                                  .OPE_INAFECTAS, .OPE_EXONERADAS, .OPE_IGV, .OPE_TOTAL)
                    End With
                Next

                With entidad
                    _id_Cabecera = SqlHelper.ExecuteScalar(tr, "FACT_SP_U_RECEIVABLE_RESUMEN_BOLETAS", _id_Cabecera, .CODIGO_RESUMEN_BOLETAS)
                End With

                tr.Commit()
                tr.Dispose()
            Catch ex As Exception
                MsgBox(ex.Message, MsgBoxStyle.Critical)
                tr.Rollback()
                estados = False
            End Try
            Return estados
        End Function

