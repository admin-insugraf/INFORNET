                        sw.WriteLine("<ID>" & dt_data.Tables(0).Rows(i)("TIPO_DOCUMENTO_IDENTIDAD") & "</ID>")
                        sw.WriteLine("<RegistrationName>" & dt_data.Tables(0).Rows(i)("RAZON_SOCIAL") & "</RegistrationName>")
