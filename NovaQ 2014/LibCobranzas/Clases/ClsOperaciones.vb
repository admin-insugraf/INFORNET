        Public Function Insert_Boletas_Pago(ls_det As List(Of ClsEntidades.PL_ATTENDENCE_STAFF_BOLETAS_PAGO_DETALLE),
                                                   cabecera As ClsEntidades.PL_ATTENDENCE_STAFF_BOLETAS_PAGO, ByVal _edicion As Boolean) As Boolean
            Dim tr As SqlTransaction = cn.BeginTransaction(IsolationLevel.Serializable)
            Dim idcab As Integer
            Try
                With cabecera
                    idcab = SqlHelper.ExecuteScalar(tr, "PL_SP_IU_EMPLOYEE_BOLETAS_PAGO ", .NUMBER_DOCUMENT, .DESCRIPCION, .USER_ID, .NOMBRE_PC, .IP_PC, .FECHA, .TIPO)
                    .NUMBER_DOCUMENT = idcab
                End With



                If _edicion = False Then 'nuevo
                    For Each d As ClsEntidades.PL_ATTENDENCE_STAFF_BOLETAS_PAGO_DETALLE In ls_det
                        With d
                            SqlHelper.ExecuteNonQuery(tr, "PL_SP_I_EMPLOYEE_BOLETAS_PAGO_DETALLE ", idcab, .EMPLOYEE_ID, .NOMBRES, .APELLIDO_PATERNO, .APELLIDO_MATERNO, .EMAIL)
                        End With
                    Next
                ElseIf _edicion = True Then 'edicion
                    SqlHelper.ExecuteNonQuery(tr, "PL_D_EMPLOYEE_BOLETAS_PAGO_DETALLE ", idcab)
                    For Each d As ClsEntidades.PL_ATTENDENCE_STAFF_BOLETAS_PAGO_DETALLE In ls_det
                        With d
                            SqlHelper.ExecuteNonQuery(tr, "PL_SP_I_EMPLOYEE_BOLETAS_PAGO_DETALLE ", idcab, .EMPLOYEE_ID, .NOMBRES, .APELLIDO_PATERNO, .APELLIDO_MATERNO, .EMAIL)
                        End With
                    Next
                End If

                tr.Commit()
                tr.Dispose()
                Return True
            Catch ex As Exception
                tr.Rollback()
                MsgBox(ex.Message)
                Return False
            End Try
        End Function


