        Public Function Genera_XML_Electronico_Comunicacion_Baja_CR(ByVal _TipoDoc As String, ByVal _serie As String, ByVal _NumeroDoc As String, _
                                               ByVal _ruta As String, ByVal _fecha As String, ByRef _ID_COMUNICACION_BAJA As String, _
                                                ByRef _ID_COMUNICACION_BAJA_CDR As String) As Boolean
            Try
                Dim fq As New LibContabilidad.ClsOperaciones.freeQuery
                Dim dt_info_emp As DataTable = fq.get_Info_Empresa()
                Dim StrNomArchivo As String
                Dim Strdatos As String = ""
                Dim ruc As String = String.Empty
                Dim razon As String = String.Empty
                Dim TDOC As String = String.Empty

                If dt_info_emp.Rows.Count > 0 Then
                    ruc = dt_info_emp.Rows(0)("VAT_REGISTRATION").ToString()
                    razon = dt_info_emp.Rows(0)("REPORT_SCREEN").ToString()
                End If

                Dim dt_data As DataSet = SqlHelper.ExecuteDataset(cn, "VENTAS_SP_S_RECEIVABLE_TXT_ELECTRONICO_COMUNICACION_BAJA_CR", _TipoDoc, _serie, _NumeroDoc, _fecha)

                If dt_data.Tables(0).Rows.Count > 0 Then
                    StrNomArchivo = _ruta & "\RR-" & CDate(_fecha).Year.ToString & Format(CDate(_fecha).Month, "00") & Format(CDate(_fecha).Day, "00") & "-" & Format(CInt(dt_data.Tables(1).Rows(0)("ITEM")), "00000") & ".xml"

                    Dim _NOMBRE_ARCHIVO As String = "RR-" & CDate(_fecha).Year.ToString & Format(CDate(_fecha).Month, "00") & Format(CDate(_fecha).Day, "00") & "-" & dt_data.Tables(1).Rows(0)("ITEM").ToString & ".xml"
                    SqlHelper.ExecuteNonQuery(cn, "VENTAS_SP_S_RECEIVABLE_COMUNICACION_BAJA_CR", _TipoDoc, _serie, _NumeroDoc, _NOMBRE_ARCHIVO)
                    _ID_COMUNICACION_BAJA = CDate(_fecha).Year.ToString & Format(CDate(_fecha).Month, "00") & Format(CDate(_fecha).Day, "00") & "-" & Format(CInt(dt_data.Tables(1).Rows(0)("ITEM")), "00000") & ".xml"
                    _ID_COMUNICACION_BAJA_CDR = CDate(_fecha).Year.ToString & Format(CDate(_fecha).Month, "00") & Format(CDate(_fecha).Day, "00") & "-" & CInt(dt_data.Tables(1).Rows(0)("ITEM")) & ".xml"

                    If Dir(StrNomArchivo) <> "" Then Kill(StrNomArchivo)
                    If Dir(_ruta, vbDirectory) = "" Then MkDir(_ruta)

                    Dim sw As New System.IO.StreamWriter(StrNomArchivo, True, System.Text.Encoding.GetEncoding(1252))

                    For i As Integer = 0 To dt_data.Tables(0).Rows.Count - 1
                        'sw.WriteLine("<?xml version=""1.0"" encoding=""UTF-8"" standalone=""no""?>")
                        sw.WriteLine("<?xml version=""1.0"" encoding=""ISO-8859-1""?>")
                        sw.WriteLine("<VoidedDocuments>")
                        sw.WriteLine("<ID>RR-" & CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Year.ToString & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Month, "00") & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Day, "00") & "-" & CInt(dt_data.Tables(1).Rows(0)("ITEM")) & "</ID>")
                        sw.WriteLine("<ReferenceDate>" & CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("DOCUMENT_DATE")).Day, "00") & "</ReferenceDate>")
                        sw.WriteLine("<IssueDate>" & CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Year.ToString & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Month, "00") & "-" & Format(CDate(dt_data.Tables(0).Rows(i)("FECHA_BAJA")).Day, "00") & "</IssueDate>")
                        sw.WriteLine("<InvoiceTypeCode>RR</InvoiceTypeCode>")

                        'DATOS DEL EMISOR
                        sw.WriteLine("<AccountingSupplierParty>")
                        sw.WriteLine("<CustomerAssignedAccountID>" & dt_data.Tables(0).Rows(i)("NUMERO_RUC") & "</CustomerAssignedAccountID>")
                        sw.WriteLine("<ID>" & dt_data.Tables(0).Rows(i)("TIPO_DOCUMENTO_IDENTIDAD") & "</ID>")
                        sw.WriteLine("<PartyLegalEntity>")
                        sw.WriteLine("<RegistrationName>" & dt_data.Tables(0).Rows(i)("RAZON_SOCIAL") & "</RegistrationName>")
                        sw.WriteLine("</PartyLegalEntity>")
                        sw.WriteLine("</AccountingSupplierParty>")

                        'DATOS DE DOCUMENTOS A ANULAR
                        sw.WriteLine("<VoidedDocumentsLine>")
                        sw.WriteLine("<DocumentTypeCode>" & dt_data.Tables(0).Rows(i)("CODIGO_SUNAT") & "</DocumentTypeCode>")
                        sw.WriteLine("<DocumentSerialID>" & dt_data.Tables(0).Rows(i)("NUMBER_SERIE") & "</DocumentSerialID>")
                        sw.WriteLine("<DocumentNumberID>" & dt_data.Tables(0).Rows(i)("NUMBER_DOCUMENT") & "</DocumentNumberID>")
                        sw.WriteLine("<VoidReasonDescription>" & dt_data.Tables(0).Rows(i)("MOTIVO_BAJA") & "</VoidReasonDescription>")
                        sw.WriteLine("</VoidedDocumentsLine>")

                        sw.WriteLine("</VoidedDocuments>")
                    Next
                    sw.Close()

                    dt_data = Nothing
                    Return True
                Else
                    Return False
                End If

            Catch ex As Exception
                MsgBox(ex.Message)
                Return False
            End Try

        End Function
