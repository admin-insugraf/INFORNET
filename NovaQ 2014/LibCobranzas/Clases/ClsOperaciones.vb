    Public Class DIRECCIONESTRANSPORTISTAS
        Dim cn As SqlConnection
        Dim dataBL As New LibConexion.ClsData
        Public Sub New()
            cn = dataBL.ConexionBD
        End Sub

        Public Function GuardarActualizar(ByVal Entidades As ClsEntidades.DIRECCIONESTRANSPORTISTAS, ByVal Nuevo As Boolean)
            Try
                With Entidades
                    If Nuevo Then
                        SqlHelper.ExecuteNonQuery(cn, "[ADDR_SP_I_TRANSPORTISTAS]", .CODIGO, .ITEM, .ADDR, .DEPARTAMENTO_ID, .PROVINCIA_ID, .DISTRITO_ID)
                    Else
                        SqlHelper.ExecuteNonQuery(cn, "[ADDR_SP_U_TRANSPORTISTAS]", .CODIGO, .ITEM, .ADDR, .DEPARTAMENTO_ID, .PROVINCIA_ID, .DISTRITO_ID)
                    End If
                End With
            Catch ex As Exception
                MsgBox(ex.Message, MsgBoxStyle.Critical)
                Return False
            End Try
            Return True
        End Function

        Public Function get_DireccionesTransportistasGenerales(codigo As String) As DataTable
            Try
                Return SqlHelper.ExecuteDataset(cn, "[ADDR_SP_S_TRANSPORTISTAS_LISTA]", codigo).Tables(0)
