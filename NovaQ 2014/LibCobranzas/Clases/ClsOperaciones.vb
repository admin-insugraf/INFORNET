                                DTDETALLESTATUSLETRA = New DataTable
                                DTDETALLESTATUSLETRA = SqlHelper.ExecuteDataset(cn, CommandType.Text, Cadena).Tables(0)
                                If DTDETALLESTATUSLETRA.Rows.Count > 0 Then
