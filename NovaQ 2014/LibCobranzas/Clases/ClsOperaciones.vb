                'Actualizando el estado de pedido
                If FacturarPedido = True Then
                    If ent_cab.NUMBER_ORDER <> String.Empty Then
                        'SqlHelper.ExecuteNonQuery(tr, CommandType.Text, "UPDATE ORDERS SET STATUS='F' WHERE ID ='" & ent_cab.NUMBER_ORDER & "'")
                        Dim dtOrdenC As DataTable
                        dtOrdenC = New DataTable
                        dtOrdenC = SqlHelper.ExecuteDataset(tr, "VENTAS_SP_S_SALDO_PEDIDOS", ent_cab.NUMBER_ORDER).Tables(0)
                        If dtOrdenC.Rows.Count() <> 0 Then
                            dtOrdenC = New DataTable
                            dtOrdenC = SqlHelper.ExecuteDataset(tr, "VENTAS_SP_S_PEDIDOS_CON_FACTURA", ent_cab.NUMBER_ORDER).Tables(0)
                            If dtOrdenC.Rows.Count() <> 0 Then
                                SqlHelper.ExecuteNonQuery(tr, CommandType.Text, "UPDATE ORDERS SET STATUS='FP',STATUS_ORDER='APROBADO' WHERE ID ='" & ent_cab.NUMBER_ORDER & "'")
                            Else
                                SqlHelper.ExecuteNonQuery(tr, CommandType.Text, "UPDATE ORDERS SET STATUS='V',STATUS_ORDER='APROBADO' WHERE ID ='" & ent_cab.NUMBER_ORDER & "'")
                            End If
                        Else
                            SqlHelper.ExecuteNonQuery(tr, CommandType.Text, "UPDATE ORDERS SET STATUS='F',STATUS_ORDER='FACTURADO' WHERE ID ='" & ent_cab.NUMBER_ORDER & "'")
                        End If

                        SqlHelper.ExecuteNonQuery(tr, "VENTAS_SP_S_PEDIDOS_ACTUALIZA_HABILITACION", ent_cab.DOCUMENT_ID, ent_cab.NUMBER_SERIE, Right(ent_cab.NUMBER_DOCUMENT, 7), ent_cab.NUMBER_ORDER)
                    End If
                End If

                If FACTURA_PEDIDO Then
                    For i As Integer = 0 To lista_pedidos.Count() - 1
                        SqlHelper.ExecuteNonQuery(tr, "SP_U_PEDIDOS_FACTURADOS_I", lista_pedidos(i).Trim, ent_cab.DOCUMENT_ID, ent_cab.NUMBER_SERIE, Right(ent_cab.NUMBER_DOCUMENT, 7), TIPO_CANCELACION)
                    Next
                End If
                ''
                If FLAG_DEV = True Then
                    If TIPO_DEV <> "" And NUM_DEV <> "" Then
                        SqlHelper.ExecuteNonQuery(tr, "FACT_SP_U_DEVOLUTION", TIPO_DEV, NUM_DEV)
                    End If
                End If
                tr.Commit()
                tr.Dispose()
            Catch ex As Exception
                tr.Rollback()
                MsgBox(ex.Message, MsgBoxStyle.Critical)
                estados = False
            End Try
            Return estados
        End Function

        Public Function GuardarFactura(ent_cab As ClsEntidades.RECEIVABLE, lista As List(Of ClsEntidades.RECEIVABLE_LINE), ent_saldo As ClsEntidades.CUSTOMER_BALANCE, _
