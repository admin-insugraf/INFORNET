        Public Function Guardar_All_Guias_Edicion(entidad As ClsEntidades.WAREHOUSE_TRANS, ls_det As List(Of ClsEntidades.WAREHOUSE_TRANS_LINE), ByVal TipoNumeracionGuia As String, _
                                             Optional ByVal MODO_EDITAR As Boolean = False, Optional ByVal REF_ALMACEN As String = "", Optional REF_TIPO_DOC As String = "", _
                                             Optional REF_NUMERO_DOC As String = "", Optional FLAG_DEV As Boolean = False) As Boolean
            

            Dim tr As SqlTransaction = cn.BeginTransaction(IsolationLevel.Serializable)
            Try
                If MODO_EDITAR = True Then
                    SqlHelper.ExecuteNonQuery(tr, "GUIA_SP_S_GUIA_REMISION_ELIMINAR_DOCUMENTOS", REF_ALMACEN, REF_TIPO_DOC, REF_NUMERO_DOC, LibComunVar.ClsVarComun.USUARIO)
                End If

                With entidad
                    SqlHelper.ExecuteNonQuery(tr, "CX_SP_I_WAREHOUSE_TRANS_III", .WAREHOUSE_ID, .DOCUMENT_ID, .NUMBER_DOCUMENT, .DATE_DOCUMENT, _
                                              .TYPE_TRANS, .TRANS_ID, .DOC_ID_REF, .NUM_ID_REF, .HOUR, .USER_ID, .CUSTOMER_ID, .VAT_REGISTRATION, _
                                              .CUSTOMER_NAME, .SALES_TERM, .CURRENCY_TYPE, .CURRENCY_EXCHANGE, .STATUS_GUIA, .AMOUNT, _
                                              .ADDR_DLV, .VENDOR_ID, .VENDOR_NAME, .COMMENT, .TYPE_GUIA, .WAREHOUSE_REF, .NUMBER_PURCHASE, .INTERFACEE, _
                                              .UPDATE_DATE, .MOV_OPTION_ID, .TRAMA_ID, .CARRIER_ID, .CARRIER_NAME, .SALES_ID, .VEHICULO_ID, .EMPTRA_ID, .NUMERO_ENTREGA, _
                                              .FECHA_TRASLADO, .MODALIDAD_TRANSPORTE, .MOTIVO_TRASLADO, .NUMBER_ORDER, .UBIGEO_PARTIDA, .DIRECCION_PARTIDA)
                End With
                '++++DEVOLUCIONES
                If FLAG_DEV = True Then
                    If entidad.DOC_ID_REF <> "" And entidad.NUM_ID_REF <> "" Then
                        Dim SQL As String = ""
                        SQL = "UPDATE DEVOLUTION SET ESTADO_ANTERIOR=ESTADO_ANTERIOR + ' GUIA DE CANJE',NUMBER_DOCUMENT_REF_GS=NUMBER_DOCUMENT_REF_GS + '" & entidad.NUMBER_DOCUMENT & "' WHERE DOCUMENT_ID = '" & entidad.DOC_ID_REF & "'  AND NUMBER_DOCUMENT ='" & entidad.NUM_ID_REF & "'"
                        SqlHelper.ExecuteNonQuery(tr, CommandType.Text, SQL)
                    End If
                End If
                For Each d As ClsEntidades.WAREHOUSE_TRANS_LINE In ls_det
                    With d
                        SqlHelper.ExecuteNonQuery(tr, "CX_SP_I_WAREHOUSE_TRANS_LINE_I", .WAREHOUSE_ID, .DOCUMENT_ID, .NUMBER_DOCUMENT, _
                                                  .ITEM, .PART_ID, .QTY, .QTY_DLV, .QTY_REF, .QTY_INVOICED, .AMOUNT_SALES, .PART_DESCRIPTION, .UNIT_PART, .NUMBER_LOT, _
                                                  .WAREHOUSE_REF, .ACCOUNT, .UNIT_PRICE, .OBSERVACIONES, .ITEM_GUIA_VENTA, .NUM_GUIA_VENTA)

                        '++++DEVOLUCIONES DETALLES
                        If FLAG_DEV = True Then
                            If entidad.DOC_ID_REF <> "" And entidad.NUM_ID_REF <> "" Then
                                Dim SQL As String = ""
                                SQL = "UPDATE DEVOLUTION_LINE SET  GENERO_NC_GUIA='SI'  WHERE DOCUMENT_ID = '" & entidad.DOC_ID_REF & "'  AND NUMBER_DOCUMENT ='" & entidad.NUM_ID_REF & "' AND  ITEM='" & d.ITEM & "'"
                                SqlHelper.ExecuteNonQuery(tr, CommandType.Text, SQL)
                            End If
                        End If

                    End With
                Next

                If FLAG_DEV = True Then
                    If entidad.DOC_ID_REF <> "" And entidad.NUM_ID_REF <> "" Then
                        SqlHelper.ExecuteNonQuery(tr, "FACT_SP_U_DEVOLUTION", entidad.DOC_ID_REF, entidad.NUM_ID_REF)
                    End If
                End If

                tr.Commit()
                tr.Dispose()
                SqlHelper.ExecuteNonQuery(cn, "GUIA_SP_S_GUIA_REMISION_NUM_DOCUMENT_GS", entidad.DOCUMENT_ID, Val(Strings.Right(entidad.NUMBER_DOCUMENT, 7)), Strings.Left(entidad.NUMBER_DOCUMENT, Strings.Len(entidad.NUMBER_DOCUMENT) - 7))
                'Actualizando Almacen
                SqlHelper.ExecuteNonQuery(cn, "ACT_QTY_LOTE_2010_AL", entidad.WAREHOUSE_ID)
                Return True
            Catch ex As Exception
                tr.Rollback()
                MsgBox(ex.Message)
                Return False
            End Try
        End Function




