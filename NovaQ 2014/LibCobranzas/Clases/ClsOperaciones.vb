                        SqlHelper.ExecuteNonQuery(trs, "PART_SP_I_U_PART_PROD_DESCUENTO", CODIGO_ART, USUARIO, CDbl(DESC1), CDbl(DESC2), CDbl(DESC3), CDbl(DESC4))
