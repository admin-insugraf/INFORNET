                        sw.WriteLine("<CountrySubentity>" & dt_data.Tables(0).Rows(i)("DEPARTAMENTO_EMISOR") & "</CountrySubentity>")
                        sw.WriteLine("<District>" & dt_data.Tables(0).Rows(i)("DISTRITO_EMISOR") & "</District>")
