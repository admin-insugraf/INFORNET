            Dim cab As New LibContabilidad.ClsEntidades.CO_TB_ASIENTO_CAB
            Dim detalle As LibContabilidad.ClsEntidades.CO_TB_ASIENTO_DET
            Dim ls_det As New List(Of LibContabilidad.ClsEntidades.CO_TB_ASIENTO_DET)

            Try
