                                                  .REM_HR_EXT_35, .REM_HR_EXT_100, .TOTAL_REM_HR_EXT, .TOTAL_REMUNERACION, .REMUNERACION_AFECTA_ESSALUD,
                                                  .REMUNERACION_AFECTA_AFP, .TOTAL_INGRESOS, .ESSALUD_VIDA_ASEG_PENSION, .ONP, .AFP_APORTE_OBLIGATORIO,
                                                  .AFP_COMISION, .AFP_PRIMA_SEG, .TOTAL_AFP, .TOTAL_DESCUENTOS, .NETO_PAGAR, .ESSALUD, .SCTR_SALUD,
                                                  .SCTR_PENSION, .SENATI, .TOTAL_APORTES, .FALTAS_D, .TARDANZAS_H, .AFP_ID, .APORTE_OBLIGATORIO,
                                                  .COMISION_VARIABLE, .COMISION_MIXTA, .PRIMA_SEGURO, .ADELANTO, .SUSPENSION_PERFECTA, .EPS, .EPS_POR,
