                        sw.WriteLine("<ID>" & dt_data.Tables(0).Rows(i)("NUMERO_PLACA") & "</ID>")
                        sw.WriteLine("</TransportEquipment>")
                        sw.WriteLine("</TransportHandlingUnit>")

                        sw.WriteLine("<OriginAddress>")
                        sw.WriteLine("<ID>" & dt_data.Tables(0).Rows(i)("UBIGEO_EMISOR") & "</ID>")
                        sw.WriteLine("<StreetName>" & dt_data.Tables(0).Rows(i)("DIRECCION_PARTIDA") & "</StreetName>")
                        sw.WriteLine("</OriginAddress>")
                        sw.WriteLine("</Shipment>")

                        'DATOS DEL ENVIO
                        For J As Integer = 0 To dt_data.Tables(1).Rows.Count - 1
                            sw.WriteLine("<DespatchLine>")
                            sw.WriteLine("<DeliveredQuantity>" & Format(Double.Parse(dt_data.Tables(1).Rows(J)("QTY")), "####0.000") & "</DeliveredQuantity>")
                            sw.WriteLine("<UM>" & dt_data.Tables(1).Rows(J)("UNIDAD") & "</UM>")
                            sw.WriteLine("<Unitcode>" & dt_data.Tables(1).Rows(J)("UNIT_ELECTRONICO") & "</Unitcode>")
                            sw.WriteLine("<Item>")
                            sw.WriteLine("<Name>" & dt_data.Tables(1).Rows(J)("PART_DESCRIPTION") & "</Name>")

                            'inicio de aki debemos obtener las lineas de la observacion

                            Dim tempArray() As String
                            Dim Strdatos_adicional As String = ""
                            Strdatos_adicional = dt_data.Tables(1).Rows(J)("PART_DESCRIPTION_ADICIONAL")
                            tempArray = Strdatos_adicional.Split(CChar(vbLf))
                            For k = LBound(tempArray) To UBound(tempArray)
                                sw.WriteLine("<Name>" & Trim(tempArray(k)) & "</Name>")
                            Next k
                            'fin de aki debemos obtener las lineas de la observacion

                            sw.WriteLine("<SellersItemIdentification>")
                            sw.WriteLine("<ID>" & dt_data.Tables(1).Rows(J)("PART_ID") & "</ID>")
                            sw.WriteLine("</SellersItemIdentification>")
                            sw.WriteLine("</Item>")
                            sw.WriteLine("<OrderLineID>" & dt_data.Tables(1).Rows(J)("ITEM") & "</OrderLineID>")
                            sw.WriteLine("<NetWeightMeasure>" & Format(Double.Parse(dt_data.Tables(1).Rows(J)("PESO_NETO")), "####0.000") & "</NetWeightMeasure>")
                            sw.WriteLine("<WeightMeasure>" & Format(Double.Parse(dt_data.Tables(1).Rows(J)("PESO_TOTAL")), "####0.000") & "</WeightMeasure>")
                            sw.WriteLine("</DespatchLine>")
                        Next

                        sw.WriteLine("<Adjuntos>")
                        If dt_data.Tables(0).Rows(i)("RucEmpresaTransporte") = "" Then
                            sw.WriteLine("<RucEmpresaTransporte>-</RucEmpresaTransporte>")
                        Else
                            sw.WriteLine("<RucEmpresaTransporte>" & dt_data.Tables(0).Rows(i)("RucEmpresaTransporte") & "</RucEmpresaTransporte>")
                        End If
                        If dt_data.Tables(0).Rows(i)("RSEmpresaTransporte") = "" Then
                            sw.WriteLine("<RSEmpresaTransporte>-</RSEmpresaTransporte>")
                        Else
                            sw.WriteLine("<RSEmpresaTransporte>" & dt_data.Tables(0).Rows(i)("RSEmpresaTransporte") & "</RSEmpresaTransporte>")
                        End If
                        If dt_data.Tables(0).Rows(i)("NUMERO_OC") = "" Then
                            sw.WriteLine("<NumeroOC>-</NumeroOC>")
                        Else
                            sw.WriteLine("<NumeroOC>" & dt_data.Tables(0).Rows(i)("NUMERO_OC") & "</NumeroOC>")
                        End If
                        sw.WriteLine("</Adjuntos>")

                        sw.WriteLine("</DespatchAdvice>")
                    Next

                    sw.Close()

                    dt_data = Nothing
                    Return True
                Else
                    Return False
                End If

            Catch ex As Exception
                MsgBox(ex.Message)
                Return False
            End Try

        End Function

