    Public Class CO_TB_PARAMETROS_RRHH
        Dim cn As SqlConnection
        Dim dataBL As New LibConexion.ClsData

        Public Sub New()
            cn = dataBL.ConexionBD
        End Sub

        Public Function getParametros() As DataTable
            Return SqlHelper.ExecuteDataset(cn, CommandType.Text, "select * from PL_PARAMETROS").Tables(0)
        End Function

        Public Function Update(ASIG_FAM As Double, FCJMMS As Double, RMV As Double, ESSALUD_VIDA As Double, ESSALUD As Double, _
                          ASEG_PENSION As Double, SCTR_SALUD As Double, SCTR_PENSION As Double, VIDA_LEY As Double, SENATI As Double, _
                          TOP_SEG As Double, APORTE_OBLIG_AFP As Double, REM_HR_100 As Double, COST_H_EXTRA1 As Double, COST_H_EXTRA2 As Double, _
                          AFP_MINERIA As Double, DIAS_MES As Double, DOMINGOS_FERIADOS As Double, HORAS_TRABAJADAS As Double, EPS_POR As Double) As Boolean

            Dim ESTADO As Boolean = True
            Dim tr As SqlTransaction
            tr = cn.BeginTransaction(IsolationLevel.Serializable)

            Try
                SqlHelper.ExecuteNonQuery(tr, "PL_SP_U_PARAMETROS", ASIG_FAM, FCJMMS, RMV, ESSALUD_VIDA, ESSALUD, ASEG_PENSION, SCTR_SALUD, SCTR_PENSION, _
                                      VIDA_LEY, SENATI, TOP_SEG, APORTE_OBLIG_AFP, REM_HR_100, COST_H_EXTRA1, COST_H_EXTRA2, AFP_MINERIA, DIAS_MES, DOMINGOS_FERIADOS, _
                                      HORAS_TRABAJADAS, EPS_POR)

                tr.Commit()
                tr.Dispose()
                Return True
            Catch ex As Exception
                tr.Rollback()
                MsgBox(ex.Message)
                ESTADO = False
            End Try
            Return ESTADO
        End Function
    End Class

