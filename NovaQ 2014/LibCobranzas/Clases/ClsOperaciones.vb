        Public Function Insert(entidad As ClsEntidades.VENDOR) As Boolean
            Dim tr As SqlTransaction
            tr = cn.BeginTransaction(IsolationLevel.Serializable)
            Try
                With entidad
                    SqlHelper.ExecuteNonQuery(tr, "CX_SP_I_VENDOR_II", .ID, .NAME, .VAT_REGISTRATION, .ADDR, .PHONE, .EMAIL, .WEBSITE, .CONTACT, _
                                              .DOCUMENT_TYPE_PERSON_ID, .TYPE_COMPANY, .ACCOUNT_LOCAL, .ACCOUNT_EXTERNAL, .USER, .CREATE_DATE, .PAIS, _
                                              .AP_PATERNO, .AP_MATERNO, .PRIMER_NOMBRE, .SEGUNDO_NOMBRE, .COD_DEPARTAMENTO, .COD_PROVINCIA, .COD_DISTRITO)
                    Dim sql As String = String.Empty
                    sql = " DELETE FROM dbo.ANNEXED WHERE ID='" & .ID & "' AND TYPE='2' "
                    SqlHelper.ExecuteNonQuery(tr, CommandType.Text, sql)
                    sql = " INSERT INTO dbo.ANNEXED (ID, TYPE, VAT_REGISTRATION, NAME, REFERENCE,BUSINESS,AP_PATERNO, AP_MATERNO, PRIMER_NOMBRE, SEGUNDO_NOMBRE) VALUES ( '" & .ID & "', '2', '" & .VAT_REGISTRATION & "', '" & .NAME & "', 'A','" & CInt(.DOCUMENT_TYPE_PERSON_ID) & "','" & .AP_PATERNO & "','" & .AP_MATERNO & "','" & .PRIMER_NOMBRE & "','" & .SEGUNDO_NOMBRE & "')"
                    SqlHelper.ExecuteNonQuery(tr, CommandType.Text, sql)

                    tr.Commit()
                    tr.Dispose()
                    Return True
                End With
            Catch ex As Exception
                tr.Rollback()
                MsgBox(ex.Message, MsgBoxStyle.Critical)
                Return False
            End Try

        End Function

