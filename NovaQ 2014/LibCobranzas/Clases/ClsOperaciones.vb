                            If dic_cta10.ContainsKey(dt_detalles.Rows(j)("ACCOUNT").ToString()) Then
                                dic_cta10(dt_detalles.Rows(j)("ACCOUNT").ToString()) += Math.Round(IIf(mon = 1, monto + interes_ganado, (monto + interes_ganado) * _TipoCambio_Ref), 2)
