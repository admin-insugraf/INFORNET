                            detalle.AD_TDOC = dt_detalles.Rows(j)("DOC_REF").ToString()
                            detalle.AD_FDOC = dt_detalles.Rows(j)("FECHA_REF").ToString()
                            detalle.AD_VDOC = dt_detalles.Rows(j)("FECHA_REF").ToString()
                            detalle.AD_SDOC = dt_detalles.Rows(j)("SERIE_REF").ToString()
