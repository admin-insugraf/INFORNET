                Return False
            End Try
            Return True
        End Function

        Public Function get_GeneracionCodigoAutomatico(codigo As String) As DataTable
            Try
                Return SqlHelper.ExecuteDataset(cn, "[ADDR_SP_S_TRANSPORTISTAS_CODIGO]", codigo).Tables(0)
