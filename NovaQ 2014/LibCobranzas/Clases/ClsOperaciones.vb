        Public Function GuardarAlmacen_Traslado(entidad_salida As ClsEntidades.WAREHOUSE_TRANS, entidad_ingreso As ClsEntidades.WAREHOUSE_TRANS,
                                       ls_det As List(Of ClsEntidades.WAREHOUSE_TRANS_LINE),
                                       ByVal Tipo_ns As String, ByVal numero_ns As String, almacen_ns As String) As Boolean
            Dim tr As SqlTransaction = cn.BeginTransaction(IsolationLevel.Serializable)
            Try
                With entidad_salida
                    SqlHelper.ExecuteNonQuery(tr, "CX_SP_I_WAREHOUSE_TRANS", .WAREHOUSE_ID, .DOCUMENT_ID, .NUMBER_DOCUMENT, .DATE_DOCUMENT, _
                                              .TYPE_TRANS, .TRANS_ID, .DOC_ID_REF, .NUM_ID_REF, .HOUR, .USER_ID, .CUSTOMER_ID, .VAT_REGISTRATION, _
                                              .CUSTOMER_NAME, .SALES_TERM, .CURRENCY_TYPE, .CURRENCY_EXCHANGE, .STATUS_GUIA, .AMOUNT, _
                                              .ADDR_DLV, .VENDOR_ID, .VENDOR_NAME, .COMMENT, .TYPE_GUIA, .WAREHOUSE_REF, .NUMBER_PURCHASE, 0, _
                                              .UPDATE_DATE, .MOV_OPTION_ID, "", "", "", "", "", "", "", "", "")

                End With
                With entidad_ingreso
                    SqlHelper.ExecuteNonQuery(tr, "CX_SP_I_WAREHOUSE_TRANS", .WAREHOUSE_ID, .DOCUMENT_ID, .NUMBER_DOCUMENT, .DATE_DOCUMENT, _
                                              .TYPE_TRANS, .TRANS_ID, .DOC_ID_REF, .NUM_ID_REF, .HOUR, .USER_ID, .CUSTOMER_ID, .VAT_REGISTRATION, _
                                              .CUSTOMER_NAME, .SALES_TERM, .CURRENCY_TYPE, .CURRENCY_EXCHANGE, .STATUS_GUIA, .AMOUNT, _
                                              .ADDR_DLV, .VENDOR_ID, .VENDOR_NAME, .COMMENT, .TYPE_GUIA, .WAREHOUSE_REF, .NUMBER_PURCHASE, 0, _
                                              .UPDATE_DATE, .MOV_OPTION_ID, "", "", "", "", "", "", "", "", "")

                End With
                For Each d As ClsEntidades.WAREHOUSE_TRANS_LINE In ls_det
                    With d
                        SqlHelper.ExecuteNonQuery(tr, "CX_SP_I_WAREHOUSE_TRANS_LINE", .WAREHOUSE_ID, .DOCUMENT_ID, .NUMBER_DOCUMENT, _
                                                  .ITEM, .PART_ID, .QTY, .QTY_DLV, .QTY_REF, .QTY_INVOICED, .AMOUNT_SALES, .PART_DESCRIPTION, .UNIT_PART, .NUMBER_LOT, _
                                                  .WAREHOUSE_REF, .ACCOUNT, .UNIT_PRICE, .OBSERVACIONES)
                    End With
                Next

                ''Actualizando
                SqlHelper.ExecuteNonQuery(tr, "ALM_SP_U_TRANF_DOC_REF", entidad_ingreso.DOCUMENT_ID, entidad_ingreso.NUMBER_DOCUMENT, entidad_ingreso.WAREHOUSE_ID,
                                          Tipo_ns, numero_ns, almacen_ns)

                'Actualizando Correlativo de Almacen
                SqlHelper.ExecuteNonQuery(tr, "ALM_SP_U_WAREHOUSE_CORRELATIVO", entidad_salida.WAREHOUSE_ID, entidad_salida.TYPE_TRANS)
                SqlHelper.ExecuteNonQuery(tr, "ALM_SP_U_WAREHOUSE_CORRELATIVO", entidad_ingreso.WAREHOUSE_ID, entidad_ingreso.TYPE_TRANS)
                'Actualizando Almacen
                For Each d As ClsEntidades.WAREHOUSE_TRANS_LINE In ls_det
                    With d
                        SqlHelper.ExecuteNonQuery(tr, "ACT_QTY_LOTE_2010_AL_CON_ARTICULO", .WAREHOUSE_ID, .PART_ID)
                    End With
                Next

                ''ACTUALIZAR SI EXISTE EN PARTQTY Y LOT 
                SqlHelper.ExecuteNonQuery(tr, "SP_U_PART_QTY_LOT", entidad_ingreso.NUMBER_DOCUMENT, entidad_ingreso.WAREHOUSE_ID, entidad_ingreso.DOCUMENT_ID)
                tr.Commit()
                tr.Dispose()
                Return True

            Catch ex As Exception
                tr.Rollback()
                MsgBox(ex.Message)
                Return False
            End Try
        End Function

