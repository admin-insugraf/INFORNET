                    SqlHelper.ExecuteNonQuery(tr, "ADM_SP_I_CURRENCY_EXCHANGE", .CURRENCY_ID, .CURRENCY_DATE, .BUY_RATE, .BUY_EQUIV, .SELL_RATE, .SELL_EQUIV, .USUARIO, .TERMINAL)
                End With
                tr.Commit()
            Catch ex As Exception
                tr.Rollback()
                MsgBox(ex.Message)
                estado = False
            End Try
            Return estado
        End Function


