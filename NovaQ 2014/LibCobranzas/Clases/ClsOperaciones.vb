                        detalle.AD_TDOC = DT_DATOS_ASIENTO.Rows(j)("AD_TDOC").ToString()
                        detalle.AD_SDOC = DT_DATOS_ASIENTO.Rows(j)("AD_SDOC").ToString()
                        detalle.AD_NDOC = DT_DATOS_ASIENTO.Rows(j)("AD_NDOC").ToString()
