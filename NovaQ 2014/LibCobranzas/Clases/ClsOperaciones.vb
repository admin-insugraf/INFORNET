                    _Consulta = "SELECT isnull(SELL_RATE,0) AS [SELL_RATE] FROM dbo.RECEIVABLE_LIST_PAY WHERE ID='" & ID_PLANILLA & "' "
                    dtTipoCamb = SqlHelper.ExecuteDataset(cn, CommandType.Text, _Consulta).Tables(0)
