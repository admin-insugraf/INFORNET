                            monto = Math.Round(Double.Parse(dt_detalles.Rows(j)("AMOUNT").ToString()), 2)
                            monto_cr = Math.Round(Double.Parse(dt_detalles.Rows(j)("AMOUNT").ToString()), 2)
                            interes_ganado = 0
                            comision_portes = 0
                            detalle = New LibContabilidad.ClsEntidades.CO_TB_ASIENTO_DET
                            mon = IIf(dt_detalles.Rows(j)("CURRENCY_ID").ToString() = "MN", 1, 2)
                            monto_cobrado = IIf(mon = 1, Math.Round(Double.Parse(dt_detalles.Rows(j)("AMOUNT").ToString()), 2), Math.Round(Double.Parse(dt_detalles.Rows(j)("AMOUNT").ToString()) * Math.Round(Double.Parse(dt_detalles.Rows(j)("SELL_RATE").ToString()), 3), 2))
